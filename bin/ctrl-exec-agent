#!/usr/bin/perl

use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/../lib";

use Exec::Agent::Config    qw();
use Exec::Agent::Schema    qw();
use Exec::Agent::AgentPairing   qw();
use Exec::Agent::Server         qw();
use Exec::Digest                qw();
use Exec::RateLimit qw();
use Exec::Log            qw();
use JSON                       qw(encode_json decode_json);
use POSIX                      qw(SIGTERM WNOHANG strftime);
use Sys::Hostname              qw(hostname);
use Getopt::Long               qw(GetOptions);

our $VERSION = 'UNINSTALLED';

# our (not my) so a unit test loading the modulino can redirect them.
our $CONFIG_PATH    = '/etc/ctrl-exec-agent/agent.conf';
our $ALLOWLIST_PATH = '/etc/ctrl-exec-agent/scripts.conf';

# --- entry point ---
# Modulino: run as a program normally, but when the file is loaded (require/do)
# by a unit test, `caller` is true and main() is skipped, so the individual
# handler subs (handle_run, handle_capabilities, ...) can be exercised directly.
main() unless caller;

sub main {
    my ($mode, %opts);

    GetOptions(
        'config=s'      => \$CONFIG_PATH,
        'allowlist=s'   => \$ALLOWLIST_PATH,
        'dispatcher=s' => \$opts{dispatcher},
        'port=i'        => \$opts{port},
        'background'    => \$opts{background},
        'timeout=i'     => \$opts{timeout},
        'lookup-by=s'   => \$opts{lookup_by},
        'version'       => sub { print "ctrl-exec-agent $VERSION\n"; exit 0; },
    ) or die usage();

    $mode = shift @ARGV;

    # No mode given: print help and exit rather than silently launching the
    # server. A bare invocation that blocks in the accept loop with no terminal
    # output looks hung; 'serve' must be requested explicitly. The init and
    # systemd units invoke 'ctrl-exec-agent serve'.
    unless (defined $mode) {
        print usage();
        return;
    }

    Exec::Log::init('ctrl-exec-agent');

    my %dispatch = (
        serve             => \&mode_serve,
        'request-pairing' => \&mode_request_pairing,
        'pairing-status'  => \&mode_pairing_status,
        'self-check'      => \&mode_self_check,
        'self-ping'       => \&mode_self_ping,
        'promote-cert'    => \&mode_promote_cert,
        'cert-staged'     => \&mode_cert_staged,
        'paired'          => \&mode_paired,
    );

    my $handler = $dispatch{$mode}
        or die "Unknown mode '$mode'\n" . usage();

    $handler->(\%opts);
}

# --- modes ---

# Promote a validated staged cert into the live cert path. Run as root by the
# service unit's ExecStartPre before the server starts, so a renewed cert
# delivered while the agent was running is adopted on the next start. Always
# returns without error: a missing or invalid staged cert must never block the
# agent from starting on its existing (still-valid) cert.
sub mode_promote_cert {
    my ($opts) = @_;

    my $config = eval { Exec::Agent::Config::load_config($CONFIG_PATH) };
    unless ($config) {
        warn "promote-cert: could not load config: $@";
        return;
    }

    my $staged = $config->{cert_staging_path}
              // '/var/lib/ctrl-exec-agent/agent.crt.staged';
    return unless -f $staged;   # nothing staged

    # Wrapped so this step can NEVER throw: it runs in ExecStartPre, where a
    # non-zero exit would block the agent from starting at all. Any failure here
    # leaves the existing (still-valid) cert in place and the agent starts on it.
    my $r = eval {
        Exec::Agent::AgentPairing::promote_staged_cert(
            staged_path => $staged,
            cert_path   => $config->{cert},
            ca_path     => $config->{ca},
            key_path    => $config->{key},
        );
    };
    unless ($r) {
        Exec::Log::log_action('WARNING',
            { ACTION => 'cert-promote', ERROR => ($@ || 'unknown error') });
        return;
    }

    if ($r->{ok} && $r->{promoted}) {
        Exec::Log::log_action('INFO', { ACTION => 'cert-promote', STATUS => 'installed' });
    }
    elsif (!$r->{ok}) {
        Exec::Log::log_action('WARNING', { ACTION => 'cert-promote', ERROR => $r->{error} });
    }
}

# Exit 0 if a renewed cert is staged and awaiting adoption, else exit 1. Reads
# cert_staging_path from config so the renew timer's decision honours an override
# (the timer cannot read the config itself). Used as the guard in
# ctrl-exec-agent-renew.service before it restarts the agent.
sub mode_cert_staged {
    my ($opts) = @_;
    my $config = eval { Exec::Agent::Config::load_config($CONFIG_PATH) };
    exit 1 unless $config;
    my $staged = $config->{cert_staging_path}
              // '/var/lib/ctrl-exec-agent/agent.crt.staged';
    exit(-f $staged ? 0 : 1);
}

# Exit 0 if the agent is paired (its cert, key and CA all exist), else exit 1.
# The procd init script gates startup on this: unlike systemd's
# RestartPreventExitStatus=78, procd would otherwise respawn an unpaired agent
# forever (serve exits 78 with no cert).
sub mode_paired {
    my ($opts) = @_;
    my $config = eval { Exec::Agent::Config::load_config($CONFIG_PATH) };
    exit 1 unless $config;
    for my $f ($config->{cert}, $config->{key}, $config->{ca}) {
        exit 1 unless defined $f && -f $f;
    }
    exit 0;
}

sub mode_serve {
    my ($opts) = @_;

    # Load and validate all configuration up front. A config error (a parse
    # error, an invalid capability, an undefined profile, ...) cannot be fixed by
    # restarting, so we must NOT die with a generic exception and let systemd
    # respawn us forever - that buries the real error under a restart loop (the
    # symptom an operator first sees is "restart counter is at 134"). Instead,
    # catch it, print exactly what and where, and exit EX_CONFIG (78), which the
    # unit lists in RestartPreventExitStatus: one clear failure, no loop.
    my ($config, $allowlist, $schemas);
    eval {
        $config    = Exec::Agent::Config::load_config($CONFIG_PATH);
        $allowlist = Exec::Agent::Config::load_allowlist($ALLOWLIST_PATH);
        $schemas   = Exec::Agent::Schema::load_for_allowlist($allowlist);

        # Fail-closed: every allowlisted script must reference a defined profile
        # (or the implicit 'default'). A typo'd or undefined profile must not
        # silently run with default privileges.
        if (my @bad = Exec::Agent::Config::validate_profiles($allowlist, $config)) {
            die "script(s) reference an undefined profile: " . join(', ', @bad)
              . "\nDefine the profile(s) in agent.conf ([profile <name>]) or "
              . "correct the profile= in scripts.conf.\n";
        }
        1;
    } or do {
        my $err = $@ || 'unknown configuration error';
        $err =~ s/ at \S+ line \d+\.?\s*$//;   # strip Perl's "at FILE line N" tail
        $err =~ s/\s+\z//;
        print STDERR <<"MSG";
ctrl-exec-agent: cannot start - configuration error.

    $err

The agent will not serve until this is corrected. Configuration lives in:
    $CONFIG_PATH
        (agent.conf - ports, certs, [profile <name>] blocks)
    $ALLOWLIST_PATH
        (scripts.conf - allowlisted scripts and their profile=)

Fix the file named above and start the agent again. Note: comments must be on
their own line; an inline '# ...' after a value becomes part of the value.
MSG
        # EX_CONFIG (78): listed in the unit's RestartPreventExitStatus so systemd
        # reports a single clear failure instead of respawning into a loop.
        exit 78;
    };

    # Profiles are enforced only by the executor. If scripts declare non-default
    # profiles but executor_socket is not set, those profiles are NOT applied -
    # the scripts run as the unprivileged agent user. Warn so this is not silent.
    unless ($config->{executor_socket}) {
        my @profiled = grep {
            (Exec::Agent::Config::script_profile($_, $allowlist) // 'default') ne 'default'
        } keys %$allowlist;
        if (@profiled) {
            warn "ctrl-exec-agent: " . scalar(@profiled) . " script(s) declare a "
               . "profile but executor_socket is not set - profiles are NOT "
               . "enforced; these scripts run as the unprivileged agent user. "
               . "Set executor_socket (and run ctrl-exec-exec.service) to apply "
               . "profiles.\n";
        }
    }

    my $revoked_path = $config->{revoked_serials}
                    // '/etc/ctrl-exec-agent/revoked-serials';
    my $revoked = Exec::Agent::AgentPairing::load_revoked_serials(
        path => $revoked_path,
    );

    my $trusted_path = $config->{trusted_dispatchers_path}
                    // '/var/lib/ctrl-exec-agent/ctrl-exec-dispatchers';
    my $trusted = Exec::Agent::AgentPairing::load_trusted_dispatchers(
        path => $trusted_path,
    );

    my %rate_state;
    my $rate_config = $config->{rate_limit} // {};

    $SIG{HUP} = sub {
        warn "Reloading allowlist, schemas, revocation list, and trusted-dispatcher map...\n";
        $allowlist = eval { Exec::Agent::Config::load_allowlist($ALLOWLIST_PATH) };
        warn "Allowlist reload failed: $@\n" if $@;
        $schemas = $allowlist
            ? (eval { Exec::Agent::Schema::load_for_allowlist($allowlist) } // {})
            : {};
        warn "Schema reload failed: $@\n" if $@;
        $revoked = eval {
            Exec::Agent::AgentPairing::load_revoked_serials(path => $revoked_path)
        };
        warn "Revocation list reload failed: $@\n" if $@;
        $trusted = eval {
            Exec::Agent::AgentPairing::load_trusted_dispatchers(path => $trusted_path)
        } // {};
        warn "Trusted-dispatcher map reload failed: $@\n" if $@;
        %rate_state = ();
    };

    # Pre-flight: the agent cannot serve until it has been paired - pairing is
    # what installs the certificate, key, and CA the TLS listener needs. Without
    # this check a missing cert makes IO::Socket::SSL die deep in its internals
    # ("SSL_cert_file ... can't be used: No such file or directory"), which tells
    # the operator nothing about the actual fix. Check the files the server is
    # about to load and, if one is absent, explain how to pair instead.
    for my $f ([certificate => $config->{cert}],
               [key         => $config->{key}],
               [CA          => $config->{ca}]) {
        my ($what, $path) = @$f;
        next if -e $path;
        print STDERR <<"MSG";
ctrl-exec-agent: cannot start - this agent has not been paired yet.

The TLS $what file it needs is missing:
    $path

Pairing installs the certificate, key, and CA an agent needs to serve. Pair
this agent with its dispatcher, as root, with:

    sudo ctrl-exec-agent request-pairing --dispatcher <dispatcher-host>

then approve the request on the dispatcher. Once pairing completes, start the
agent again. Run 'ctrl-exec-agent pairing-status' to check pairing state.
MSG
        # Exit EX_CONFIG (78), not 1: "not paired" is a configuration state that
        # restarting cannot fix. The systemd unit lists 78 in
        # RestartPreventExitStatus, so an enabled-but-unpaired agent fails once
        # with the message above instead of respawning every RestartSec forever.
        # A genuine crash still exits non-78 and is restarted as normal.
        exit 78;
    }

    require IO::Socket::SSL;
    require Exec::TLS;

    my $server = IO::Socket::SSL->new(
        LocalPort        => $config->{port},
        Listen           => 10,
        ReuseAddr        => 1,
        SSL_cert_file    => $config->{cert},
        SSL_key_file     => $config->{key},
        SSL_ca_file      => $config->{ca},
        SSL_verify_mode  => IO::Socket::SSL::SSL_VERIFY_PEER(),
        Exec::TLS::hardening(),
    ) or die "Cannot start server: $IO::Socket::SSL::SSL_ERROR\n";

    Exec::Log::log_action('INFO', {
        ACTION => 'start',
        PORT   => $config->{port},
    });

    # Aggregate concurrent-handler cap, on top of the per-IP rate limit below.
    # The agent only accepts CA-signed peers, so this is defence-in-depth against
    # a many-peer flood. Generous default; configurable via max_children. $live is
    # kept exact - reaped synchronously in this loop (no async SIGCHLD handler).
    my $max_children = $config->{max_children} // 256;
    my $live = 0;

    while (1) {
        my $conn = $server->accept;

        unless (defined $conn) {
            my $err  = $IO::Socket::SSL::SSL_ERROR // '';
            my $peer = $server->peerhost // 'unknown';

            # Distinguish TLS handshake failure from a fatal socket error.
            # A handshake failure leaves $! at 0 (or EAGAIN/EINTR); the SSL
            # error string describes the cert/protocol problem. A fatal error
            # (server socket closed, accept(2) syscall failed) sets $! to a
            # real errno value. Exit the loop only on fatal errors.
            if ($!) {
                Exec::Log::log_action('ERR', {
                    ACTION => 'accept-fatal',
                    PEER   => $peer,
                    REASON => "$!",
                });
                last;
            }

            Exec::RateLimit::record_failure($peer, \%rate_state, $rate_config);
            Exec::Log::log_action('WARNING', {
                ACTION => 'tls-failure',
                PEER   => $peer,
                REASON => $err,
            });
            Exec::RateLimit::check($peer, \%rate_state, $rate_config);
            next;
        }

        my $peer        = $conn->peerhost // 'unknown';

        # IP allowlist check: before rate check, before fork, before peer serial
        if ($config->{allowed_ips} &&
            !Exec::Agent::Config::ip_allowed($peer, $config->{allowed_ips})) {
            $conn->close(SSL_no_shutdown => 1);
            Exec::Log::log_action('WARNING', {
                ACTION => 'ip-block',
                PEER   => $peer,
            });
            next;
        }

        if (Exec::RateLimit::check($peer, \%rate_state, $rate_config)) {
            $conn->close(SSL_no_shutdown => 1);
            next;
        }
        Exec::RateLimit::record_connection($peer, \%rate_state, $rate_config);

        # Reap ALL finished children before admitting this one, dropping them
        # from the live count (also stops exited handlers accumulating as zombies
        # under bursty-then-idle load; matches the API and executor loops).
        $live-- while waitpid(-1, WNOHANG()) > 0;

        if ($live >= $max_children) {
            $conn->close(SSL_no_shutdown => 1);
            Exec::Log::log_action('WARNING',
                { ACTION => 'overload', PEER => $peer, LIVE => $live });
            next;
        }

        # Read peer cert serial before forking - after the parent closes its
        # copy of $conn the SSL object becomes invalid in the child.
        my $peer_serial = _peer_serial($conn);
        my $pid  = fork();
        if (!defined $pid) {
            warn "fork failed: $!\n";
            $conn->close(SSL_no_shutdown => 1);
            next;
        }
        if ($pid == 0) {
            # Child: close server socket, handle connection, exit
            $server->close(SSL_no_shutdown => 1);
            Exec::Agent::Server::handle_connection($conn, $peer, $allowlist, $config, $revoked, $trusted, $peer_serial, $schemas, $VERSION);
            $conn->close;
            exit 0;
        }
        # Parent: count the live child and release fd without SSL shutdown.
        $live++;
        $conn->close(SSL_no_shutdown => 1);
    }
}

sub mode_request_pairing {
    my ($opts) = @_;

    my $ctrl_exec_host  = $opts->{dispatcher}
        or die "--dispatcher <host> required for request-pairing\n";
    my $background  = $opts->{background} // 0;
    my $timeout     = $opts->{timeout}    // 30;
    my $lookup_by   = $opts->{lookup_by};

    if (defined $lookup_by && $lookup_by ne 'ip' && $lookup_by ne 'hostname') {
        die "--lookup-by must be 'ip' or 'hostname'\n";
    }

    if ($background && $timeout > 600) {
        die "Error: --timeout cannot exceed 600 seconds in background mode.\n"
          . "The agent connection window is 660 seconds; values above 600 risk\n"
          . "the connection expiring before approval is received.\n";
    }

    # Pre-flight: verify the cert directory exists and is writable before
    # generating the key or connecting to the ctrl-exec. Without this check,
    # a non-root run fails with a cryptic rename error inside store_certs after
    # the full pairing connection has already completed.
    my $cert_dir = '/etc/ctrl-exec-agent';
    die "Cert directory '$cert_dir' does not exist - has the agent been installed?\n"
        unless -d $cert_dir;
    die "Cannot write to '$cert_dir' - re-run as root or with sudo\n"
        unless -w $cert_dir;

    my $host = Exec::Agent::Server::fqdn();
    unless ($host =~ /\./) {
        warn <<"WARN";
Warning: could not determine a fully-qualified domain name for this host;
registering the short name '$host'. A dispatcher on a different network or
subdomain may be unable to resolve it. Configure a domain (FQDN) on this host,
or pair with --lookup-by ip so the dispatcher reaches this agent by address.
WARN
    }

    # Report the agent's configured operational port so the dispatcher can
    # store it and reach this agent without a per-command --port. Read the
    # config leniently: a missing or incomplete config must not block pairing.
    my $agent_port = do {
        my $cfg = eval { Exec::Agent::Config::load_config($CONFIG_PATH) };
        ($cfg && $cfg->{port}) ? $cfg->{port} : 7443;
    };

    # Fail fast: probe the pairing port before generating a 4096-bit key, so an
    # unreachable ctrl-exec (host down, wrong address, or simply not in pairing
    # mode) is reported in seconds instead of after a slow keygen and a hung
    # connect. A successful probe only proves the port is open - it does not
    # prove pairing mode is active; the TLS handshake in submit confirms that.
    my $pair_port = $opts->{port} // 7444;
    _preflight_dispatcher($ctrl_exec_host, $pair_port);

    print "Generating key and CSR for '$host'...\n" unless $background;
    my $pair = Exec::Agent::AgentPairing::generate_key_and_csr(
        hostname => $host,
    );

    unless ($background) {
        my $pairing_code = _pairing_code($pair->{csr_pem});
        print "Pairing code: $pairing_code\n";
        print "  Verify this code matches the ctrl-exec display before approving.\n\n";
        print "Connecting to ctrl-exec at $ctrl_exec_host for pairing...\n";
    }

    # Submit the CSR. The ctrl-exec queues it and returns a reqid immediately.
    my $submitted = Exec::Agent::AgentPairing::submit_pairing_request(
        'ctrl-exec' => $ctrl_exec_host,
        port       => $pair_port,
        csr_pem    => $pair->{csr_pem},
        hostname   => $host,
        lookup_by  => $lookup_by,
        agent_port => $agent_port,
    );

    unless ($submitted->{ok}) {
        my $err = $submitted->{error} // 'unknown error';
        if ($err =~ /IO::Socket::IP configuration failed|Name or service not known|Temporary failure in name resolution/i) {
            die "Pairing failed: could not resolve ctrl-exec hostname '$ctrl_exec_host'.\n"
              . "Check the hostname is correct or use an IP address instead.\n";
        }
        if ($err =~ /connection refused|No route to host/i) {
            die "Pairing failed: could not connect to ctrl-exec at $ctrl_exec_host:$pair_port.\n"
              . "Check the ctrl-exec address is correct and pairing mode is active:\n"
              . "  sudo ctrl-exec pairing-mode\n";
        }
        # The pre-flight probe reached the port, so a TLS/handshake failure here
        # means something is listening but not speaking the pairing protocol -
        # almost always the ctrl-exec is up but not in pairing mode.
        if ($err =~ /unexpected eof|SSL connect|handshake|connect failed|no response|empty acknowledgement/i) {
            die "Pairing failed: reached $ctrl_exec_host:$pair_port, but it is not\n"
              . "responding as a pairing listener. The ctrl-exec is most likely\n"
              . "running but not in pairing mode. On the ctrl-exec host, run:\n"
              . "  sudo ctrl-exec pairing-mode\n";
        }
        die "Pairing failed: $err\n";
    }

    my $reqid = $submitted->{reqid};

    if ($background) {
        # Print reqid to stdout for the orchestrator, then fork.
        # Parent exits 0 immediately. Child waits for approval subject to timeout.
        print "$reqid\n";
        STDOUT->flush;

        my $pid = fork();
        die "fork failed: $!\n" unless defined $pid;

        if ($pid != 0) {
            # Parent: exit cleanly. Socket fd is inherited by child.
            exit 0;
        }

        # Child: detach from terminal, wait for approval with timeout.
        # $submitted->{sock} is inherited across the fork.
        local $SIG{ALRM} = sub {
            Exec::Log::log_action('WARNING', {
                ACTION => 'pair-timeout',
                REQID  => $reqid,
            });
            exit 2;
        };
        alarm $timeout;

        my $result = Exec::Agent::AgentPairing::await_pairing_result(
            sock  => $submitted->{sock},
            nonce => $submitted->{nonce},
            reqid => $reqid,
        );
        alarm 0;

        unless ($result->{ok}) {
            Exec::Log::log_action('WARNING', {
                ACTION => 'pair-denied',
                REQID  => $reqid,
                REASON => $result->{error} // 'denied',
            });
            exit 3;
        }

        _store_pairing_result($result, $pair->{key_pem}, $ctrl_exec_host);
        return;
    }

    # Interactive (non-background) mode: await inline.
    my $result = Exec::Agent::AgentPairing::await_pairing_result(
        sock  => $submitted->{sock},
        nonce => $submitted->{nonce},
        reqid => $reqid,
    );

    unless ($result->{ok}) {
        my $err = $result->{error} // 'unknown error';
        die "Pairing failed: $err\n";
    }

    _store_pairing_result($result, $pair->{key_pem}, $ctrl_exec_host);
    print "Pairing complete. Certificates stored.\n";
    _print_start_instructions();
}

sub _store_pairing_result {
    my ($result, $key_pem, $ctrl_exec_host) = @_;

    Exec::Agent::AgentPairing::store_certs(
        cert_pem          => $result->{cert_pem},
        ca_pem            => $result->{ca_pem},
        key_pem           => $key_pem,
        dispatcher_serial => $result->{dispatcher_serial} // '',
        dispatcher_id     => $result->{dispatcher_id}     // '',
    );

    Exec::Log::log_action('INFO', {
        ACTION         => 'pair-complete',
        STATUS         => 'approved',
        DISPATCHER     => $result->{dispatcher_id} // '',
        DISPATCHER_HOST => $ctrl_exec_host,
    });
}

sub mode_pairing_status {
    my $status = Exec::Agent::AgentPairing::pairing_status();
    if ($status->{paired}) {
        print "Paired. Certificate expires: $status->{expiry}\n";
    }
    else {
        print "Not paired. Reason: $status->{reason}\n";
        exit 1;
    }
}

sub mode_self_check {
    print "Checking config...\n";
    my $config = eval { Exec::Agent::Config::load_config($CONFIG_PATH) };
    if ($@) { print "Config error: $@\n"; exit 1; }
    print "  Config OK (port $config->{port})\n";

    my $allowlist = eval { Exec::Agent::Config::load_allowlist($ALLOWLIST_PATH) };
    if ($@) { print "Allowlist error: $@\n"; exit 1; }
    printf "  Allowlist OK (%d scripts)\n", scalar keys %$allowlist;

    my $status = Exec::Agent::AgentPairing::pairing_status();
    if ($status->{paired}) {
        print "  Certs OK (expires $status->{expiry})\n";
    }
    else {
        print "  Certs: NOT paired - $status->{reason}\n";
    }

    for my $name (sort keys %$allowlist) {
        my $path    = Exec::Agent::Config::validate_script($name, $allowlist);
        my $profile = Exec::Agent::Config::script_profile($name, $allowlist);
        my $ok      = (defined $path && -x $path) ? 'ok' : 'NOT EXECUTABLE';
        print "  Script '$name': $path  (profile: $profile) [$ok]\n";
    }

    # Fail-closed: a script referencing an undefined profile is a config error.
    my @bad = Exec::Agent::Config::validate_profiles($allowlist, $config);
    if (@bad) {
        print "  Profile error: undefined profile(s) referenced: ",
              join(', ', @bad), "\n";
    }

    print "Self-check complete.\n";
}

sub mode_self_ping {
    print "Checking config...\n";
    my $config = eval { Exec::Agent::Config::load_config($CONFIG_PATH) };
    if ($@) { print "Config error: $@\n"; exit 1; }
    my $port = $config->{port} // 7443;
    print "  Config OK (port $port)\n";

    # Pairing and cert status
    my $status = Exec::Agent::AgentPairing::pairing_status();
    if ($status->{paired}) {
        print "  Paired: yes (cert expires $status->{expiry})\n";
    }
    else {
        print "  Paired: no - $status->{reason}\n";
        print "  Cannot self-ping: agent not paired.\n";
        exit 1;
    }

    # Attempt mTLS connection to self on loopback
    print "Connecting to 127.0.0.1:$port...\n";
    require IO::Socket::SSL;   # lazy-loaded so the CLI modes stay light; JSON is
                               # already imported at the top.

    my $conn = IO::Socket::SSL->new(
        PeerHost           => '127.0.0.1',
        PeerPort           => $port,
        SSL_cert_file      => $config->{cert},
        SSL_key_file       => $config->{key},
        SSL_ca_file        => $config->{ca},
        SSL_verify_mode    => IO::Socket::SSL::SSL_VERIFY_PEER(),
        SSL_verifycn_scheme => 'none',   # loopback: skip hostname check, CA trust is sufficient
        Timeout            => 5,
    );

    unless ($conn) {
        my $err = $IO::Socket::SSL::SSL_ERROR // $@;
        if ($err =~ /connection refused/i) {
            print "  Port $port: not listening - is the agent running?\n";
        } else {
            print "  mTLS handshake failed: $err\n";
        }
        exit 1;
    }

    print "  Port $port: listening\n";
    print "  mTLS handshake: OK\n";

    # Send a ping request
    my $reqid = sprintf('%08x', int(rand(0xffffffff)));
    my $body  = JSON::encode_json({ reqid => $reqid });
    print $conn "POST /ping HTTP/1.0\r\n";
    print $conn "Content-Type: application/json\r\n";
    print $conn "Content-Length: " . length($body) . "\r\n";
    print $conn "\r\n";
    print $conn $body;

    my $response = '';
    while (my $line = <$conn>) { $response .= $line; }
    close $conn;

    if ($response =~ /"status"\s*:\s*"ok"/) {
        print "  Ping response: OK\n";
    } elsif ($response =~ /serial mismatch|serial.reject/i) {
        # 403 serial mismatch is expected: the agent correctly rejects a
        # connection from our own cert (not the dispatcher cert). The agent
        # is running and enforcing serial policy correctly.
        print "  Ping response: 403 serial mismatch (expected - agent is running and enforcing policy)\n";
    } else {
        print "  Ping response: unexpected - $response\n";
        exit 1;
    }

    print "Self-ping complete.\n";
}


# Compute a 6-digit confirmation code from a CSR PEM string.
# The same computation on the ctrl-exec side produces an identical code,
# allowing the operator to verify the request visually without any
# out-of-band channel.
sub _pairing_code {
    return Exec::Digest::pairing_code($_[0]);
}

# Quick TCP reachability probe for the pairing port, run before the slow keygen.
# Dies with an actionable message if the ctrl-exec cannot be reached at all.
# A successful probe only proves the port is open - it does NOT prove pairing
# mode is active; the TLS handshake in submit_pairing_request confirms that and
# reports a distinct "not in pairing mode" error if it fails.
sub _preflight_dispatcher {
    my ($host, $port) = @_;
    require IO::Socket::INET;
    my $probe = IO::Socket::INET->new(
        PeerHost => $host,
        PeerPort => $port,
        Proto    => 'tcp',
        Timeout  => 5,
    );
    return if $probe;   # reachable - socket closes when $probe leaves scope
    die "Pairing failed: cannot reach ctrl-exec at $host:$port.\n"
      . "Check the address is correct, the ctrl-exec host is up, and that it\n"
      . "is running pairing mode:\n"
      . "  sudo ctrl-exec pairing-mode\n";
}


# After a successful interactive pairing the agent has an identity but is not
# running yet: installation deliberately does not enable or start it (it cannot
# serve until paired). Tell the operator how to bring it up - enabling as well as
# starting, so it also survives a reboot - rather than leaving them to discover
# the agent still is not serving.
sub _print_start_instructions {
    # A running agent loads its certificate and trusted-dispatcher map once, at
    # startup (the map also refreshes on SIGHUP, but the certificate does not).
    # Pairing here just wrote new files on disk; if the agent is already running
    # - i.e. this was a re-pair - it must be restarted to adopt the new identity
    # and to trust the dispatcher's current serial. Skipping this is the classic
    # cause of a post-re-pair "serial mismatch": the new serial is on disk but the
    # live process is still matching against the map it loaded at startup.
    my $running = -d '/run/systemd/system'
        && system('systemctl', 'is-active', '--quiet', 'ctrl-exec-agent') == 0;

    if ($running) {
        print "\nThis agent is already running. Restart it so the new certificate"
            . " and the\ndispatcher's current serial take effect (a re-pair changes"
            . " both):\n\n";
        print "    sudo systemctl restart ctrl-exec-agent\n";
        print "\nWithout this restart the running agent keeps matching against the"
            . " trusted-\ndispatcher map it loaded at startup, and requests are"
            . " rejected as a serial\nmismatch.\n";
    }
    else {
        print "\nThe agent is paired but not running yet. Enable and start it:\n\n";
        if (-d '/run/systemd/system') {
            print "    sudo systemctl enable --now ctrl-exec-agent\n";
        }
        elsif (-e '/etc/init.d/ctrl-exec-agent') {
            print "    /etc/init.d/ctrl-exec-agent enable\n";
            print "    /etc/init.d/ctrl-exec-agent start\n";
        }
        else {
            print "    sudo ctrl-exec-agent serve\n";
        }
    }
    print "\nThen verify with: ctrl-exec-agent self-ping\n";
}

sub usage {
    return <<'END';
Usage: ctrl-exec-agent <mode> [options]

Modes:
  serve                          Start the agent server
  request-pairing --dispatcher <host>
                                 Request pairing with the ctrl-exec dispatcher host
  pairing-status                 Show pairing/cert status
  self-check                     Validate local config and certs
  self-ping                      Connect to self on port 7443, verify mTLS and pairing

Options:
  --config <path>                Path to agent.conf
  --allowlist <path>             Path to scripts.conf
  --port <n>                     Override pairing port (default 7444)
  --lookup-by <ip|hostname>      Suggest how the dispatcher should resolve this
                                 agent for dispatch (default: hostname). The
                                 dispatcher's approve --lookup-by overrides it.
  --background                   Non-interactive pairing: print reqid and wait
                                 for approval (for orchestrated installations)
  --timeout <n>                  Seconds to wait for approval in background
                                 mode (default 30, max 600)
  --version                      Print version and exit
END
}

1;   # modulino: true return so the file can be require'd by a unit test
