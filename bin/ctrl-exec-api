#!/usr/bin/perl

use strict;
use warnings;
use feature qw(signatures);
no warnings qw(experimental::signatures);
use FindBin qw($Bin);
use lib "$Bin/../lib";

use Exec::Log qw();
use Exec::API qw();
use Exec::DispatcherConfig qw();
use Getopt::Long    qw(GetOptions);

our $VERSION = 'UNINSTALLED';

# Default: /etc/ctrl-exec-dispatcher/ctrl-exec.conf - resolved in main. A real
# /etc/ctrl-exec still present is refused (exit 78), see Exec::DispatcherConfig.
my $CONFIG_PATH;

main();

sub main {
    GetOptions('config=s' => \$CONFIG_PATH)
        or die usage();

    Exec::Log::init('ctrl-exec-api');

    # T-047: a real old config directory is refused up front, whatever the mode,
    # so it is logged and exits 78 (EX_CONFIG) rather than failing part way.
    if (defined(my $legacy = Exec::DispatcherConfig::legacy_dir_error())) {
        Exec::Log::log_action('ERR', {
            ACTION => 'config-dir',
            RESULT => 'refused',
            OLD    => $Exec::DispatcherConfig::LEGACY_DIR,
            NEW    => $Exec::DispatcherConfig::CONF_DIR,
        });
        print STDERR $legacy;
        exit 78;
    }

    $CONFIG_PATH //= Exec::DispatcherConfig::conf_path();
    my $config = load_config($CONFIG_PATH);

    Exec::API::run(config => $config);
}

sub load_config ($path) {
    return Exec::DispatcherConfig::load_config($path);
}

sub usage {
    return <<'END';
Usage: ctrl-exec-api [options]

Options:
  --config <path>    Path to ctrl-exec.conf (default /etc/ctrl-exec-dispatcher/ctrl-exec.conf)

The API server reads its configuration from ctrl-exec.conf.
Relevant keys:
  api_port   Port to listen on (default 7445)
  api_cert   TLS certificate (optional - plain HTTP if absent)
  api_key    TLS private key  (optional - plain HTTP if absent)
  auth_hook  Auth hook executable (optional)
END
}
