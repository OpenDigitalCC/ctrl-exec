#!/usr/bin/perl

use strict;
use warnings;
use feature qw(signatures);
no warnings qw(experimental::signatures);
use FindBin qw($Bin);
use lib "$Bin/../lib";

use Exec::Log qw();
use Exec::API qw();
use Exec::DispatcherConfig qw();
use Getopt::Long    qw(GetOptions);

our $VERSION = 'UNINSTALLED';

# Default: /etc/ctrl-exec-dispatcher/ctrl-exec.conf - resolved in main. A real
# config still at /etc/ctrl-exec is used in place; an ambiguous one is refused
# (exit 78), see Exec::DispatcherConfig.
my $CONFIG_PATH;

main();

sub main {
    GetOptions('config=s' => \$CONFIG_PATH)
        or die usage();

    Exec::Log::init('ctrl-exec-api');

    # T-047/T-065: an ambiguous config directory is refused up front, whatever
    # the mode, so it is logged and exits 78 (EX_CONFIG) rather than failing part
    # way; a real config still at the old /etc/ctrl-exec is used in place and
    # logged.
    Exec::DispatcherConfig::startup_check();

    $CONFIG_PATH //= Exec::DispatcherConfig::conf_path();
    my $config = load_config($CONFIG_PATH);

    # Listener settings that name no listener, half a TLS pair, an unreadable
    # TLS file or an unknown socket group are refused here, before anything is
    # bound - 78 (EX_CONFIG), which systemd does not restart.
    my $plan = Exec::API::listen_plan($config);
    unless ($plan->{ok}) {
        Exec::Log::log_action('ERR', {
            ACTION => 'api-config',
            RESULT => 'refused',
            REASON => $plan->{error},
        });
        print STDERR "ctrl-exec-api: $plan->{error}\n";
        exit 78;
    }

    Exec::API::run(config => $config);
}

sub load_config ($path) {
    return Exec::DispatcherConfig::load_config($path);
}

sub usage {
    return <<'END';
Usage: ctrl-exec-api [options]

Options:
  --config <path>    Path to ctrl-exec.conf (default /etc/ctrl-exec-dispatcher/ctrl-exec.conf)

The API server reads its configuration from ctrl-exec.conf.
Relevant keys:
  api_socket        Unix socket path (optional; mode 0660)
  api_socket_group  Group of the unix socket (default: the server's group)
  api_bind          TCP address (default 127.0.0.1)
  api_port          TCP port (default 7445; off = no TCP listener)
  api_tls_cert      TLS certificate for the TCP listener (optional, with api_tls_key)
  api_tls_key       TLS private key for the TCP listener (optional, with api_tls_cert)
  auth_hook         Auth hook executable (optional)

Confidential run input should only travel over the unix socket or TLS.
END
}
