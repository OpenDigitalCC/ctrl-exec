#!/bin/bash
# update-ctrl-exec-serial - update this agent's trusted-dispatcher map during
# dispatcher certificate rotation, without re-pairing.
#
# Called on the agent by the dispatcher over the run channel as part of
# add-then-remove cert rotation:
#   - When a dispatcher rotates its cert, it broadcasts the NEW serial together
#     with its stable identity; the agent ADDS that serial to the map, keeping
#     the old one trusted during the overlap window.
#   - After the overlap window, the dispatcher broadcasts a removal of the OLD
#     serial; the agent REMOVES it. The retired cert is then no longer trusted.
#
# Because the agent maps the serial to the dispatcher's stable identity (which
# does not change across rotation), trust and attribution are undisturbed.
#
# Usage:
#   update-ctrl-exec-serial <serial> <dispatcher-id>   # trust <serial> as <dispatcher-id>
#   update-ctrl-exec-serial --remove <serial>          # stop trusting <serial>
#
# The map lives in the agent-writable state directory so this script (run as the
# agent service user over the run channel) can update trust without root. One
# entry per line: "<hex-serial> <dispatcher-id>". Other dispatchers' entries and
# comment lines are preserved. After editing, the agent is sent SIGHUP to reload.
#
# TRUST REQUIREMENT: this changes which dispatcher certs the agent trusts. It
# should only be in scripts.conf on agents whose dispatcher uses cert rotation.
# Any caller able to invoke it already holds a valid mTLS cert signed by the CA;
# the risk is bounded by the CA trust model (a serial is inert without a
# CA-signed cert bearing it).
#
# Exit codes:
#   0   success
#   1   usage / validation error
#   2   write failed
#   3   reload failed

set -euo pipefail

# Paths default to the standard install locations; both can be overridden via
# the environment for non-standard installations and for testing.
TRUSTED_FILE="${ENVEXEC_TRUSTED_FILE:-/var/lib/ctrl-exec-agent/ctrl-exec-dispatchers}"
AGENT_PID_FILE="${ENVEXEC_AGENT_PIDFILE:-/run/ctrl-exec-agent.pid}"

usage() {
    echo "Usage: update-ctrl-exec-serial <serial> <dispatcher-id>" >&2
    echo "       update-ctrl-exec-serial --remove <serial>" >&2
}

# --- parse arguments ---

MODE=""
SERIAL=""
DISPATCHER_ID=""

if [ "${1:-}" = "--remove" ]; then
    if [ $# -ne 2 ]; then usage; exit 1; fi
    MODE="remove"
    SERIAL="$2"
elif [ $# -eq 2 ]; then
    MODE="add"
    SERIAL="$1"
    DISPATCHER_ID="$2"
else
    usage
    exit 1
fi

# --- validate serial ---

if ! printf '%s' "$SERIAL" | grep -qE '^[0-9a-fA-F]+$'; then
    echo "Invalid serial format: must be hex string" >&2
    exit 1
fi
SERIAL_LEN="${#SERIAL}"
if [ "$SERIAL_LEN" -lt 8 ] || [ "$SERIAL_LEN" -gt 40 ]; then
    echo "Invalid serial length: expected 8-40 hex characters, got $SERIAL_LEN" >&2
    exit 1
fi
# Normalise to lowercase - matches how the agent stores and compares serials.
SERIAL="${SERIAL,,}"

# --- validate dispatcher id (add only) ---

if [ "$MODE" = "add" ]; then
    if ! printf '%s' "$DISPATCHER_ID" | grep -qE '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'; then
        echo "Invalid dispatcher id: must start alphanumeric, then [A-Za-z0-9._-], max 64" >&2
        exit 1
    fi
fi

# --- edit the map atomically ---

TRUSTED_DIR="$(dirname "$TRUSTED_FILE")"
if [ ! -d "$TRUSTED_DIR" ]; then
    echo "Trusted-dispatcher map directory '$TRUSTED_DIR' does not exist" >&2
    exit 2
fi

# Build the new content in a temp file: every existing line except the one for
# this serial (comments and other dispatchers preserved), then for 'add' the new
# entry. Any failure in this block is a write failure (exit 2).
if ! {
    TMP_FILE=$(mktemp "$TRUSTED_DIR/.ctrl-exec-dispatchers.XXXXXX") &&
    if [ -f "$TRUSTED_FILE" ]; then
        awk -v s="$SERIAL" '
            /^[[:space:]]*#/  { print; next }   # comments
            /^[[:space:]]*$/  { print; next }   # blank lines
            { if (tolower($1) != s) print }     # other dispatchers
        ' "$TRUSTED_FILE" > "$TMP_FILE"
    else
        : > "$TMP_FILE"
    fi &&
    if [ "$MODE" = "add" ]; then
        printf '%s %s\n' "$SERIAL" "$DISPATCHER_ID" >> "$TMP_FILE"
    fi &&
    chmod 0644 "$TMP_FILE" &&
    mv "$TMP_FILE" "$TRUSTED_FILE"
}; then
    echo "Failed to update trusted-dispatcher map '$TRUSTED_FILE'" >&2
    [ -n "${TMP_FILE:-}" ] && rm -f "$TMP_FILE" 2>/dev/null
    exit 2
fi

# --- reload agent ---
# Send SIGHUP to reload the map without restarting. Try pidfile first, then
# pidof as fallback.

AGENT_PID=""
if [ -f "$AGENT_PID_FILE" ]; then
    AGENT_PID=$(cat "$AGENT_PID_FILE" 2>/dev/null)
fi
if [ -z "$AGENT_PID" ]; then
    AGENT_PID=$(pidof ctrl-exec-agent 2>/dev/null || true)
fi

if [ -n "$AGENT_PID" ]; then
    if kill -HUP "$AGENT_PID" 2>/dev/null; then
        if [ "$MODE" = "add" ]; then
            echo "Trusted serial ${SERIAL} (${DISPATCHER_ID}) added. Agent reloaded (pid $AGENT_PID)."
        else
            echo "Serial ${SERIAL} removed from trust. Agent reloaded (pid $AGENT_PID)."
        fi
        exit 0
    else
        echo "Map updated but SIGHUP to pid $AGENT_PID failed." >&2
        echo "Reload manually: kill -HUP \$(pidof ctrl-exec-agent)" >&2
        exit 3
    fi
else
    echo "Map updated but agent process not found - reload manually." >&2
    exit 3
fi
