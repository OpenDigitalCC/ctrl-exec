[Unit]
Description=ctrl-exec-dispatcher API - HTTP API server for remote script execution
Documentation=https://github.com/OpenDigitalCC/ctrl-exec
After=network.target
Wants=network.target

[Service]
Type=simple
# The API server bind address and port are configured in ctrl-exec.conf via
# api_bind (default: 127.0.0.1) and api_port (default: 7445).
# The server is not reachable from the network without explicitly setting
# api_bind = 0.0.0.0 or a specific interface address in ctrl-exec.conf.
ExecStart=/usr/bin/ctrl-exec-api
Restart=on-failure
RestartSec=5

# Run as the unprivileged ctrl-exec service user - NOT root. It owns the
# dispatcher private key (0600), so it can read it to mTLS to agents, and it is in
# the ctrl-exec group for the runtime dirs (registry, runs, locks). An RCE in this
# network-facing JSON server is therefore not root. Cert renewal (which needs the
# root-owned CA key) is not done here - it runs from `ced maintain` (root timer).
# Note: api_port defaults to 7445 (unprivileged); to bind a port < 1024 add
# AmbientCapabilities=CAP_NET_BIND_SERVICE.
User=ctrl-exec
Group=ctrl-exec

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ctrl-exec

[Install]
WantedBy=multi-user.target
