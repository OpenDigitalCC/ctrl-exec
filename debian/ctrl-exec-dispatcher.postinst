#!/bin/sh
set -e

case "$1" in
    configure)
        # System group for control-host access to certs and runtime dirs.
        if ! getent group ctrl-exec >/dev/null; then
            addgroup --system ctrl-exec
        fi

        # Service user the API server runs as (member of the ctrl-exec group). It
        # owns the dispatcher private key (still 0600) so the API need not run as
        # root; group members get read-only registry/run access only.
        if ! getent passwd ctrl-exec >/dev/null; then
            adduser --system --no-create-home --ingroup ctrl-exec \
                --shell /usr/sbin/nologin ctrl-exec
        fi

        # Upgrade from before 0.13 (T-008): the config directory was /etc/ctrl-exec
        # and is now /etc/ctrl-exec-dispatcher. If only the old one exists, move it,
        # leave a symlink at the old name for one release (removed in 0.14), and
        # point the paths inside ctrl-exec.conf at the new directory so nothing
        # depends on the symlink (previous file kept as ctrl-exec.conf.pre-0.13).
        # If both exist the new one is used and the old one left for the operator.
        if [ -d /etc/ctrl-exec ] && [ ! -L /etc/ctrl-exec ]; then
            if [ -e /etc/ctrl-exec-dispatcher ]; then
                echo "ctrl-exec: both /etc/ctrl-exec and /etc/ctrl-exec-dispatcher exist;" >&2
                echo "ctrl-exec: using the latter and leaving /etc/ctrl-exec alone." >&2
            else
                mv /etc/ctrl-exec /etc/ctrl-exec-dispatcher
                ln -s /etc/ctrl-exec-dispatcher /etc/ctrl-exec
                echo "ctrl-exec: moved /etc/ctrl-exec to /etc/ctrl-exec-dispatcher (symlink left until 0.14)."
                conf=/etc/ctrl-exec-dispatcher/ctrl-exec.conf
                if [ -f "$conf" ] && grep -q '=[[:space:]]*/etc/ctrl-exec/' "$conf"; then
                    cp -p "$conf" "$conf.pre-0.13"
                    sed -i 's|\(=[[:space:]]*\)/etc/ctrl-exec/|\1/etc/ctrl-exec-dispatcher/|' "$conf"
                fi
            fi
        fi

        # Config directory.
        mkdir -p /etc/ctrl-exec-dispatcher
        chmod 750 /etc/ctrl-exec-dispatcher
        chown root:ctrl-exec /etc/ctrl-exec-dispatcher

        # Runtime state: pairing queue, agent registry, locks, run results.
        # setgid (2770) on the shared dirs so files created by the root CLI and by
        # the unprivileged ctrl-exec API both inherit the ctrl-exec group - each can
        # then read (and, for locks, flock) what the other wrote.
        for d in pairing agents locks runs; do
            mkdir -p "/var/lib/ctrl-exec/$d"
            chmod 2770 "/var/lib/ctrl-exec/$d"
            chown root:ctrl-exec "/var/lib/ctrl-exec/$d"
        done

        # Migrate files created before the API was de-rooted (root-group) to the
        # ctrl-exec group so the now-unprivileged API can read run records and
        # flock locks the root CLI created.
        chgrp -R ctrl-exec /var/lib/ctrl-exec/agents /var/lib/ctrl-exec/locks \
                           /var/lib/ctrl-exec/runs 2>/dev/null || true
        find /var/lib/ctrl-exec/locks -type f -exec chmod g+w {} + 2>/dev/null || true

        # Seed config and example auth hook on first install only.
        if [ ! -f /etc/ctrl-exec-dispatcher/ctrl-exec.conf ]; then
            cp /usr/share/ctrl-exec/examples/ctrl-exec.conf.example \
               /etc/ctrl-exec-dispatcher/ctrl-exec.conf
            chmod 640 /etc/ctrl-exec-dispatcher/ctrl-exec.conf
            chown root:ctrl-exec /etc/ctrl-exec-dispatcher/ctrl-exec.conf
        fi
        # The seeded ctrl-exec.conf does not name this hook (T-046): it
        # authorises everything, so it is a starting point to copy and edit,
        # inactive until the operator sets auth_hook.
        if [ ! -f /etc/ctrl-exec-dispatcher/auth-hook ]; then
            cp /usr/share/ctrl-exec/examples/auth-hook.example \
               /etc/ctrl-exec-dispatcher/auth-hook
            chmod 755 /etc/ctrl-exec-dispatcher/auth-hook
        fi
        # Tell the operator, once, why the API will say "no auth hook configured".
        if [ -z "$2" ] && ! grep -q '^[[:space:]]*auth_hook[[:space:]]*=' \
                /etc/ctrl-exec-dispatcher/ctrl-exec.conf 2>/dev/null; then
            echo "ctrl-exec: ced (CLI) works as installed. The API denies every request until"
            echo "ctrl-exec: you enable authorisation: edit /etc/ctrl-exec-dispatcher/auth-hook"
            echo "ctrl-exec: (the example allows everything), then uncomment the auth_hook line in"
            echo "ctrl-exec: /etc/ctrl-exec-dispatcher/ctrl-exec.conf and restart ctrl-exec-api."
        fi

        # Migration: hand an existing dispatcher private key to the ctrl-exec user
        # (still 0600) so the now-unprivileged API can read it. setup-ctrl-exec /
        # rotate-cert do this for newly generated keys; this covers keys created
        # before the de-rooting. Resolve the configured key path, default to
        # dispatcher.key, and chown only if it exists.
        key_path=$(sed -n 's/^[[:space:]]*key[[:space:]]*=[[:space:]]*//p' \
                   /etc/ctrl-exec-dispatcher/ctrl-exec.conf 2>/dev/null | head -n1)
        [ -n "$key_path" ] || key_path=/etc/ctrl-exec-dispatcher/dispatcher.key
        if [ -f "$key_path" ]; then
            chown ctrl-exec:ctrl-exec "$key_path"
            chmod 600 "$key_path"
        fi
        ;;
esac

#DEBHELPER#

# On upgrade only ($2 holds the previously-configured version), restart the API
# service if it is already running so the new code takes effect. The package
# ships the unit with dh_installsystemd --no-start (rules), which suppresses the
# restart-after-upgrade that compat 13 would otherwise do; without this the old
# code keeps running until a manual restart. Gate on is-active so a stopped or
# unconfigured API server is left alone. The dispatcher CLI itself is not a
# service. Runs after the debhelper-generated section, so its daemon-reload has
# loaded any new unit. (Do not write the debhelper token in this comment - it
# would be substituted a second time and splice shell code into the comment.)
case "$1" in
    configure)
        if [ -n "$2" ] && [ -d /run/systemd/system ] \
           && systemctl is-active --quiet ctrl-exec-api.service; then
            deb-systemd-invoke restart ctrl-exec-api.service || true
        fi
        ;;
esac

exit 0
