
# Dont send generated pdfs
*.pdf

# dont automatically send packages
ctrl-exec-*.tar.gz
ctrl-exec-*.tar.gz.sha256

# Built Debian packages are tracked in dist/ (latest release only;
# make-release.sh prunes stale-version debs). Their dpkg-buildpackage
# byproducts are build metadata, not artefacts to ship:
*.buildinfo
*.changes

# Keep local for now
TODO.md

# Disposable diagnostic scripts and commit-message files (see
# ~/.claude/CLAUDE.md command-composition conventions)
tmp/
.claude/

# Local helper scripts from assistant sessions (prompt-reduction wrappers),
# not part of the project tree
scripts/

