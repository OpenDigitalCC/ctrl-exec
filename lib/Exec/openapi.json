{
  "openapi": "3.1.0",
  "info": {
    "title": "ctrl-exec API",
    "description": "REST gateway for the ctrl-exec mTLS remote script execution system. Provides programmatic access to the run, ping, discovery, and health endpoints. Authentication is delegated to the configured auth hook on the ctrl-exec host; pass credentials in the request body. Under load the server may return 503 on any endpoint when it is at its concurrent-request cap (api_max_children).",
    "version": "0.12.3",
    "license": {
      "name": "AGPL-3.0-only"
    },
    "contact": {
      "url": "https://github.com/OpenDigitalCC/ctrl-exec"
    }
  },
  "servers": [
    {
      "url": "http://{host}:{port}",
      "description": "Plain HTTP (no api_cert/api_key configured)",
      "variables": {
        "host": { "default": "localhost" },
        "port": { "default": "7445" }
      }
    },
    {
      "url": "https://{host}:{port}",
      "description": "TLS (api_cert and api_key configured)",
      "variables": {
        "host": { "default": "localhost" },
        "port": { "default": "7445" }
      }
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns the API server version and confirms the process is alive. No authentication required.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "ok": true,
                  "version": "0.12.3"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "API index",
        "description": "Human-readable index of the API with links to the OpenAPI documents.",
        "operationId": "getIndex",
        "responses": {
          "200": { "description": "Index document" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI specification (static)",
        "description": "The bundled OpenAPI 3.1 specification for this API.",
        "operationId": "getOpenapi",
        "responses": {
          "200": { "description": "OpenAPI specification" }
        }
      }
    },
    "/openapi-live.json": {
      "get": {
        "summary": "OpenAPI specification (live)",
        "description": "The OpenAPI specification augmented at request time with the scripts and schema sidecars discovered across the live agent fleet (host/script enums).",
        "operationId": "getOpenapiLive",
        "responses": {
          "200": { "description": "OpenAPI specification with live host/script data" }
        }
      }
    },
    "/ping": {
      "post": {
        "summary": "Ping agents",
        "description": "Test mTLS connectivity to one or more agents. Returns cert expiry and agent version for each host. Runs against all specified hosts in parallel.",
        "operationId": "pingAgents",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PingRequest" },
              "example": {
                "hosts": ["web-01", "web-02"],
                "username": "alice",
                "token": "mytoken"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ping results for all hosts (individual host failures are reported inline, not as HTTP errors)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PingResponse" },
                "example": {
                  "ok": true,
                  "results": [
                    {
                      "host": "web-01",
                      "status": "ok",
                      "rtt": "12ms",
                      "expiry": "Jan 15 12:00:00 2026 GMT",
                      "version": "0.12.3"
                    },
                    {
                      "host": "web-02",
                      "status": "error",
                      "error": "read timeout after 60s",
                      "rtt": "60012ms"
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/run": {
      "post": {
        "summary": "Run a script on agents",
        "description": "Execute an allowlisted script on one or more agents in parallel. The script name must match an entry in each agent's scripts.conf allowlist. Arguments are passed as positional values to the script. The ctrl-exec waits up to read_timeout seconds (default 60) per host.",
        "operationId": "runScript",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RunRequest" },
              "example": {
                "hosts": ["db-01", "db-02"],
                "script": "pg-backup",
                "args": ["--database", "myapp"],
                "username": "alice",
                "token": "mytoken"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution results for all hosts. Individual host failures are reported inline via exit code and error fields, not as HTTP errors.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RunResponse" },
                "example": {
                  "ok": true,
                  "results": [
                    {
                      "host": "db-01",
                      "exit": 0,
                      "stdout": "Backup complete: myapp_20250115.sql.gz\n",
                      "stderr": "",
                      "rtt": "4210ms",
                      "reqid": "a1b2c3d4"
                    },
                    {
                      "host": "db-02",
                      "exit": -1,
                      "error": "read timeout after 60s",
                      "stdout": "",
                      "stderr": "",
                      "rtt": "60001ms",
                      "reqid": "a1b2c3d5"
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Asynchronous submission accepted (async=true). Each agent has started the script detached; poll GET /status/{reqid} for results. Per-host acceptance is reported inline (accepted, busy, or error).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AsyncSubmitResponse" },
                "example": {
                  "ok": true,
                  "async": true,
                  "reqid": "a1b2c3d4e5f60718",
                  "results": [
                    { "host": "db-01", "status": "accepted", "reqid": "a1b2c3d4e5f60718", "rtt": "12ms" },
                    { "host": "db-02", "status": "busy", "error": "script already running", "reqid": "a1b2c3d4e5f60718", "rtt": "9ms" }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/status/{reqid}": {
      "get": {
        "summary": "Get the status/result of a run",
        "description": "Returns the stored record for a request id. For a synchronous run this is the completed result. For an asynchronous run (async=true on /run) the API fetches any still-pending host results from the agents, merges them, and returns the per-host state: accepted/running (still going), done (with exit/stdout/stderr), expired (the agent purged its result), or error. Records are purged after 24 hours.",
        "operationId": "getRunStatus",
        "parameters": [
          {
            "name": "reqid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-f0-9]+$" },
            "description": "The request id returned by POST /run.",
            "example": "a1b2c3d4e5f60718"
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Optional 'Bearer <token>' credential. When an auth hook is configured it can owner-gate the result (returned only to an authorised caller); an unauthorised request gets 404 so the run's existence is not disclosed. With no hook, possession of the unguessable reqid is the capability.",
            "example": "Bearer mytoken"
          }
        ],
        "responses": {
          "200": {
            "description": "The run record. Shape differs by mode: a sync record carries a results array; an async record carries a per-host hosts map plus complete/pending.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusResponse" },
                "example": {
                  "ok": true,
                  "reqid": "a1b2c3d4e5f60718",
                  "script": "pg-backup",
                  "mode": "async",
                  "complete": false,
                  "pending": ["db-02"],
                  "hosts": {
                    "db-01": { "status": "done", "exit": 0, "stdout": "Backup complete\n", "stderr": "" },
                    "db-02": { "status": "running" }
                  }
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/discovery": {
      "get": {
        "summary": "Discover agents and capabilities",
        "description": "Returns all registered agents and their allowlisted scripts. Defaults to all agents in the registry when no hosts are specified. Uses ping privilege level for auth. Equivalent to the POST form with an empty body.",
        "operationId": "discoverAgentsGet",
        "responses": {
          "200": { "$ref": "#/components/responses/DiscoverySuccess" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "summary": "Discover agents and capabilities (filtered)",
        "description": "Returns agents and their allowlisted scripts. Optionally filter to a specific set of hosts. If no hosts are specified, all registered agents are queried.",
        "operationId": "discoverAgentsPost",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DiscoveryRequest" },
              "example": {
                "hosts": ["web-01", "db-01"],
                "username": "alice",
                "token": "mytoken"
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/DiscoverySuccess" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["ok", "version"],
        "properties": {
          "ok":      { "type": "boolean", "enum": [true] },
          "version": { "type": "string", "description": "ctrl-exec version string", "example": "0.12.3" }
        }
      },
      "PingRequest": {
        "type": "object",
        "required": ["hosts"],
        "properties": {
          "hosts": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Hostname or hostname:port. Port defaults to 7443."
            },
            "minItems": 1,
            "example": ["web-01", "web-02:7450"]
          },
          "username": {
            "type": "string",
            "description": "Operator username passed to the auth hook. Defaults to empty string.",
            "example": "alice"
          },
          "token": {
            "type": "string",
            "description": "Auth token passed to the auth hook.",
            "example": "mytoken"
          }
        }
      },
      "PingResult": {
        "type": "object",
        "required": ["host", "status"],
        "properties": {
          "host":    { "type": "string", "description": "Agent hostname as supplied in the request." },
          "status":  { "type": "string", "enum": ["ok", "error"] },
          "rtt":     { "type": "string", "description": "Round-trip time, e.g. 12ms.", "example": "12ms" },
          "expiry":  { "type": "string", "description": "Agent certificate expiry (openssl notAfter format). Present when status is ok.", "example": "Jan 15 12:00:00 2026 GMT" },
          "version": { "type": "string", "description": "Agent version string. Present when status is ok.", "example": "0.12.3" },
          "error":   { "type": "string", "description": "Error message. Present when status is error.", "example": "read timeout after 60s" }
        }
      },
      "PingResponse": {
        "type": "object",
        "required": ["ok", "results"],
        "properties": {
          "ok":      { "type": "boolean", "enum": [true] },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/PingResult" } }
        }
      },
      "RunRequest": {
        "type": "object",
        "required": ["hosts", "script"],
        "properties": {
          "hosts": {
            "type": "array",
            "items": { "type": "string", "description": "Hostname or hostname:port." },
            "minItems": 1,
            "example": ["db-01", "db-02"]
          },
          "script": {
            "type": "string",
            "pattern": "^[\\w-]+$",
            "description": "Allowlisted script name (alphanumeric and hyphens only). Must match an entry in the agent's scripts.conf.",
            "example": "pg-backup"
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Positional arguments passed to the script. Evaluated on the ctrl-exec host before dispatch.",
            "example": ["--database", "myapp"]
          },
          "username": { "type": "string", "example": "alice" },
          "token":    { "type": "string", "example": "mytoken" },
          "async": {
            "type": "boolean",
            "description": "Submit detached (for long-running jobs). When true the agents start the script in the background and the API returns 202 with a reqid immediately; fetch results later from GET /status/{reqid}. Defaults to false (synchronous).",
            "example": false
          }
        }
      },
      "RunResult": {
        "type": "object",
        "required": ["host", "exit"],
        "properties": {
          "host":   { "type": "string" },
          "exit": {
            "type": "integer",
            "description": "Script exit code. 0 indicates success. -1 indicates a ctrl-exec-side failure (connection error, timeout). 126 indicates the script was killed by a signal or exec failed."
          },
          "stdout": { "type": "string", "description": "Script standard output." },
          "stderr": { "type": "string", "description": "Script standard error." },
          "rtt":    { "type": "string", "description": "Round-trip time including script execution.", "example": "4210ms" },
          "reqid":  { "type": "string", "description": "Request ID. Matches the REQID field in syslog on both ctrl-exec and agent. Use to correlate results with log entries.", "example": "a1b2c3d4" },
          "error":  { "type": "string", "description": "ctrl-exec error message. Present when exit is -1.", "example": "read timeout after 60s" },
          "script": { "type": "string", "description": "Script name as dispatched." }
        }
      },
      "RunResponse": {
        "type": "object",
        "required": ["ok", "reqid", "results"],
        "properties": {
          "ok":      { "type": "boolean", "enum": [true] },
          "reqid":   { "type": "string", "description": "The run id; poll GET /status/{reqid} for the stored record." },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/RunResult" } }
        }
      },
      "AsyncSubmitResult": {
        "type": "object",
        "required": ["host", "status"],
        "properties": {
          "host":   { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["accepted", "busy", "error"],
            "description": "accepted: job started detached. busy: the agent refused because the same script is already running. error: the submission failed (e.g. serial mismatch, host unreachable)."
          },
          "reqid":  { "type": "string" },
          "rtt":    { "type": "string", "example": "12ms" },
          "error":  { "type": "string", "description": "Present for busy/error." }
        }
      },
      "AsyncSubmitResponse": {
        "type": "object",
        "required": ["ok", "reqid", "results"],
        "properties": {
          "ok":      { "type": "boolean", "enum": [true] },
          "async":   { "type": "boolean", "enum": [true] },
          "reqid":   { "type": "string", "description": "Poll GET /status/{reqid} for results.", "example": "a1b2c3d4e5f60718" },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/AsyncSubmitResult" } }
        }
      },
      "HostStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["accepted", "running", "done", "expired", "busy", "error"],
            "description": "accepted/running: still in progress. done: finished (exit/stdout/stderr present). expired: the agent purged its result before it was fetched. busy/error: the job never ran on this host."
          },
          "exit":        { "type": "integer", "description": "Present when status is done." },
          "stdout":      { "type": "string" },
          "stderr":      { "type": "string" },
          "error":       { "type": "string", "description": "Present for busy/error." },
          "fetch_error": { "type": "string", "description": "Transient fetch failure on the last poll; the host stays pending and is retried." }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": ["ok", "reqid"],
        "description": "A run record. A sync record carries a results array; an async record carries a per-host hosts map plus complete/pending.",
        "properties": {
          "ok":        { "type": "boolean", "enum": [true] },
          "reqid":     { "type": "string" },
          "script":    { "type": "string" },
          "mode":      { "type": "string", "enum": ["sync", "async"] },
          "complete":  { "type": "boolean", "description": "True when no host is still pending." },
          "pending":   { "type": "array", "items": { "type": "string" }, "description": "Hosts still running (async only)." },
          "hosts": {
            "description": "Async: a map of hostname to its current status. Sync: the array of hostnames the run was dispatched to.",
            "oneOf": [
              { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/HostStatus" } },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "results":   { "type": "array", "items": { "$ref": "#/components/schemas/RunResult" }, "description": "Sync only. Per-host results as returned by /run." },
          "completed": { "type": "integer", "description": "Sync only. Unix time the run completed." }
        }
      },
      "DiscoveryRequest": {
        "type": "object",
        "properties": {
          "hosts":    { "type": "array", "items": { "type": "string" }, "description": "Hosts to query. Defaults to all registered agents if omitted." },
          "username": { "type": "string" },
          "token":    { "type": "string" }
        }
      },
      "ScriptEntry": {
        "type": "object",
        "properties": {
          "name":       { "type": "string", "description": "Script name as it appears in scripts.conf.", "example": "pg-backup" },
          "path":       { "type": "string", "description": "Absolute path on the agent host.", "example": "/opt/ctrl-exec-scripts/pg-backup.sh" },
          "executable": { "type": "boolean", "description": "Whether the script file is executable by the ctrl-exec-agent process." }
        }
      },
      "HostCapabilities": {
        "type": "object",
        "properties": {
          "host":    { "type": "string" },
          "status":  { "type": "string", "enum": ["ok", "error"] },
          "version": { "type": "string" },
          "reported_hostname": { "type": "string", "description": "The host the agent reports itself as (may differ from the registry key)." },
          "tags":    { "type": "object", "additionalProperties": { "type": "string" }, "description": "Agent-reported tags, cached in the registry on discovery." },
          "scripts": { "type": "array", "items": { "$ref": "#/components/schemas/ScriptEntry" } },
          "error":   { "type": "string" }
        }
      },
      "DiscoveryResponse": {
        "type": "object",
        "required": ["ok", "hosts"],
        "properties": {
          "ok": { "type": "boolean", "enum": [true] },
          "hosts": {
            "type": "object",
            "description": "Map of hostname to capabilities. Keys are the agent hostnames as registered.",
            "additionalProperties": { "$ref": "#/components/schemas/HostCapabilities" },
            "example": {
              "web-01": {
                "host": "web-01",
                "status": "ok",
                "version": "0.12.3",
                "scripts": [
                  { "name": "deploy", "path": "/opt/ctrl-exec-scripts/deploy.sh", "executable": true },
                  { "name": "status", "path": "/opt/ctrl-exec-scripts/status.sh", "executable": true }
                ]
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["ok", "error"],
        "properties": {
          "ok":     { "type": "boolean", "enum": [false] },
          "error":  { "type": "string", "description": "Short error class.", "example": "bad request" },
          "detail": { "type": "string", "description": "Additional context. Present on 400 responses.", "example": "hosts must be a non-empty array" },
          "code": {
            "type": "integer",
            "description": "Auth/lock error code. 1=denied, 2=bad credentials, 3=insufficient privilege, 4=lock conflict.",
            "enum": [1, 2, 3, 4]
          },
          "conflicts": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Hosts with active locks. Present on 409 responses."
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request body or missing required fields.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "ok": false, "error": "bad request", "detail": "hosts must be a non-empty array" }
          }
        }
      },
      "Forbidden": {
        "description": "Auth hook denied the request. The code field indicates the denial reason: 1=denied, 2=bad credentials, 3=insufficient privilege.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "ok": false, "error": "bad credentials", "code": 2 }
          }
        }
      },
      "Conflict": {
        "description": "One or more target hosts are locked by a concurrent operation.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "ok": false, "error": "locked", "code": 4, "conflicts": ["db-01"] }
          }
        }
      },
      "NotFound": {
        "description": "No record exists for the given request id (never issued, or purged after the 24h TTL).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "ok": false, "error": "not found", "detail": "no result for reqid deadbeef" }
          }
        }
      },
      "DiscoverySuccess": {
        "description": "Agent capabilities keyed by hostname.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/DiscoveryResponse" }
          }
        }
      }
    }
  }
}
