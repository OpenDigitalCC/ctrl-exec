# NixOS module for the ctrl-exec agent: services.ctrl-exec-agent.
#
# Replaces what install.sh does on other platforms (useradd, sed of installed
# files, in-place executor build, FHS unit files). The units keep every
# hardening line of etc/systemd/*.service; only the FHS paths change.
#
# Scripts are COPIED OUT of the Nix store into /opt/ctrl-exec-scripts as real
# root-owned 0755 files (never symlinks): the agent's trust walk refuses any
# script whose path crosses a group-writable directory, and /nix/store is
# root:nixbld 1775. See docs/NIXOS.md.
{ config, lib, pkgs, ... }:

let
  cfg = config.services.ctrl-exec-agent;

  confDir = "/etc/ctrl-exec-agent";
  stateDir = "/var/lib/ctrl-exec-agent";
  scriptsDir = "/opt/ctrl-exec-scripts";
  execSock = "/run/ctrl-exec-agent/exec.sock";

  # agent.conf: top-level keys, then [tags], then [profile <name>] sections
  # (keys must come before the first section header).
  kv = attrs: lib.concatStringsSep "\n"
    (lib.mapAttrsToList (k: v: "${k} = ${toString v}") attrs);

  agentConf = pkgs.writeText "agent.conf" ''
    # Generated by the NixOS module services.ctrl-exec-agent. Do not edit.
    ${kv cfg.settings}
    ${cfg.extraConfig}

    ${lib.optionalString (cfg.tags != { }) "[tags]\n${kv cfg.tags}\n"}
    ${lib.concatStringsSep "\n" (lib.mapAttrsToList
      (name: p: "[profile ${name}]\n${kv p}\n") cfg.profiles)}
  '';

  scriptLine = name: s:
    "${name} = ${scriptsDir}/${name}"
    + lib.concatStrings (lib.mapAttrsToList (k: v: " ${k}=${v}") s.options);

  scriptsConf = pkgs.writeText "scripts.conf" ''
    # Generated by the NixOS module services.ctrl-exec-agent. Do not edit.
    ${lib.concatStringsSep "\n" (lib.mapAttrsToList scriptLine cfg.scripts)}
  '';

  # Copy each configured script out of the store as a real root-owned file.
  # A manifest of what the module installed lets it remove a script that is no
  # longer configured, and nothing else in the directory.
  newManifest = pkgs.writeText "ctrl-exec-scripts-manifest"
    (lib.concatMapStrings (n: n + "\n") (lib.attrNames cfg.scripts));

  copyScripts = pkgs.writeShellScript "ctrl-exec-copy-scripts" ''
    set -eu
    d=${scriptsDir}
    ${pkgs.coreutils}/bin/install -d -m 0755 -o 0 -g 0 "$d"
    manifest="$d/.nix-managed"
    ${lib.concatStrings (lib.mapAttrsToList (name: s: ''
      ${pkgs.coreutils}/bin/install -m 0755 -o 0 -g 0 \
        ${lib.escapeShellArg "${s.source}"} "$d/.${name}.tmp"
      ${pkgs.coreutils}/bin/mv -f "$d/.${name}.tmp" "$d/${name}"
    '') cfg.scripts)}
    if [ -f "$manifest" ]; then
      while read -r old; do
        if ! ${pkgs.gnugrep}/bin/grep -qxF -- "$old" ${newManifest} && [ -f "$d/$old" ] && [ ! -L "$d/$old" ]; then
          ${pkgs.coreutils}/bin/rm -f -- "''${d:?}/''${old:?}"
        fi
      done < "$manifest"
    fi
    ${pkgs.coreutils}/bin/install -m 0644 -o 0 -g 0 ${newManifest} "$manifest"
  '';

  scriptType = lib.types.submodule {
    options = {
      source = lib.mkOption {
        type = lib.types.path;
        description = ''
          The script to install: a file in the Nix store (a path literal, a
          writeShellScript result, or "''${pkg}/bin/name"). It is copied to
          ${scriptsDir}/<name> as a root-owned 0755 regular file.
        '';
      };
      options = lib.mkOption {
        type = lib.types.attrsOf lib.types.str;
        default = { };
        example = { profile = "cert-deploy"; input = "fields"; };
        description = "key=value options on the scripts.conf entry (profile, input, output, dispatchers).";
      };
    };
  };
in
{
  options.services.ctrl-exec-agent = {
    enable = lib.mkEnableOption "the ctrl-exec agent";

    package = lib.mkOption {
      type = lib.types.package;
      default = (pkgs.callPackage ./package.nix { }).ctrl-exec-agent;
      defaultText = lib.literalMD "the `ctrl-exec-agent` package built from this repository";
      description = "The ctrl-exec-agent package (it also carries the executor).";
    };

    port = lib.mkOption {
      type = lib.types.port;
      default = 7443;
      description = "TCP port the agent listens on (the dispatcher connects to it).";
    };

    bind = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "127.0.0.1";
      description = ''
        The one IPv4 or IPv6 address the agent listens on, written to
        agent.conf as `bind`. Null (the default) leaves `bind` out: the agent
        listens on every address. Not a host name; an invalid value stops the
        agent starting.
      '';
    };

    openFirewall = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Open the agent's port in the firewall.";
    };

    scriptPath = lib.mkOption {
      type = lib.types.str;
      default = "/run/wrappers/bin:/run/current-system/sw/bin";
      description = ''
        PATH scripts run with: a colon list of absolute directories, written
        to agent.conf as `script_path`. The agent's built-in default (the
        FHS directories) holds almost nothing on NixOS.
      '';
    };

    settings = lib.mkOption {
      type = lib.types.attrsOf (lib.types.oneOf [ lib.types.str lib.types.int ]);
      default = { };
      example = { script_ownership = "strict"; allowed_ips = "192.0.2.10"; };
      description = ''
        Extra top-level agent.conf keys (see etc/agent.conf.example), merged
        with the module's own: port, bind (when set), cert, key, ca, script_path and, with the
        executor enabled, executor_socket.
      '';
    };

    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Extra top-level agent.conf lines, verbatim (before any section).";
    };

    tags = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = { };
      example = { env = "prod"; role = "db"; };
      description = "The [tags] section of agent.conf.";
    };

    profiles = lib.mkOption {
      type = lib.types.attrsOf (lib.types.attrsOf lib.types.str);
      default = { };
      example = { cert-deploy = { run_as = "root"; caps = "CAP_CHOWN"; writable = "/etc/nginx/ssl"; }; };
      description = ''
        Security profiles ([profile <name>] sections). 'default' must exist:
        the agent refuses to serve if a script resolves to an undefined
        profile, so the module defines it as the restrictive baseline
        (run_as = nobody, no_new_privileges = yes) unless you set it.
        Profiles are applied only when `executor.enable` is set.
      '';
    };

    scripts = lib.mkOption {
      type = lib.types.attrsOf scriptType;
      default = { };
      example = lib.literalExpression ''
        {
          hello = { source = ./hello.sh; };
          deploy-cert = { source = ./deploy-cert.sh; options.profile = "cert-deploy"; };
        }
      '';
      description = ''
        The script allowlist (scripts.conf), name -> script. Each source is
        copied to ${scriptsDir}/<name> as a real root-owned file, and the
        entry points at that copy. Names are limited to [A-Za-z0-9_-].
      '';
    };

    executor.enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Run the privileged executor and set `executor_socket`. Profiles
        (run_as, capabilities, writable paths) are enforced only with it.
        Off by default: --async runs are refused while it is on.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [{
      assertion = lib.all (n: builtins.match "[A-Za-z0-9_-]+" n != null) (lib.attrNames cfg.scripts);
      message = "services.ctrl-exec-agent.scripts: names are limited to [A-Za-z0-9_-].";
    }];

    services.ctrl-exec-agent.settings = {
      port = lib.mkDefault cfg.port;
      cert = lib.mkDefault "${confDir}/agent.crt";
      key = lib.mkDefault "${confDir}/agent.key";
      ca = lib.mkDefault "${confDir}/ca.crt";
      script_path = lib.mkDefault cfg.scriptPath;
    } // lib.optionalAttrs (cfg.bind != null) { bind = lib.mkDefault cfg.bind; }
      // lib.optionalAttrs cfg.executor.enable { executor_socket = lib.mkDefault execSock; };

    services.ctrl-exec-agent.profiles.default = lib.mkDefault {
      run_as = "nobody";
      no_new_privileges = "yes";
    };

    users.groups.ctrl-exec-agent = { };
    users.users.ctrl-exec-agent = {
      isSystemUser = true;
      group = "ctrl-exec-agent";
      description = "ctrl-exec agent service user";
    };

    environment.systemPackages = [ cfg.package ];

    networking.firewall.allowedTCPPorts = lib.mkIf cfg.openFirewall [ cfg.port ];

    # Copied, not linked: the agent and the executor both want real files, and
    # a store symlink fails the ownership checks. Never manage the whole
    # directory: pairing writes the cert, key and CA into it.
    environment.etc."ctrl-exec-agent/agent.conf" = {
      source = agentConf;
      mode = "0640";
      user = "root";
      group = "ctrl-exec-agent";
    };
    environment.etc."ctrl-exec-agent/scripts.conf" = {
      source = scriptsConf;
      mode = "0640";
      user = "root";
      group = "ctrl-exec-agent";
    };

    systemd.tmpfiles.rules = [
      "d ${confDir} 0750 root ctrl-exec-agent -"
      "d ${stateDir} 0750 ctrl-exec-agent ctrl-exec-agent -"
      "d ${stateDir}/runs 0750 ctrl-exec-agent ctrl-exec-agent -"
      "d ${scriptsDir} 0755 root root -"
    ];

    # At every activation (boot and switch), before units start. Numeric ids:
    # on a systemd-initrd boot this runs before /etc/passwd exists.
    system.activationScripts.ctrl-exec-agent-scripts = {
      text = "${copyScripts}";
    };

    systemd.services.ctrl-exec-agent = {
      description = "ctrl-exec Agent - remote script execution service";
      documentation = [ "https://github.com/OpenDigitalCC/ctrl-exec" ];
      after = [ "network.target" ];
      wants = [ "network.target" ];
      wantedBy = [ "multi-user.target" ];
      # A port, cert, key or CA change needs a restart; scripts.conf the agent
      # reloads by itself, so a script change only reloads.
      restartTriggers = [ agentConf ];
      reloadTriggers = [ scriptsConf ];
      serviceConfig = {
        Type = "simple";
        User = "ctrl-exec-agent";
        Group = "ctrl-exec-agent";
        # '+' runs the promote step as root, outside the sandbox, so it can
        # write the root-owned /etc/ctrl-exec-agent. Always succeeds.
        ExecStartPre = "+${cfg.package}/bin/ctrl-exec-agent promote-cert";
        ExecStart = "${cfg.package}/bin/ctrl-exec-agent serve";
        ExecReload = "${pkgs.coreutils}/bin/kill -HUP $MAINPID";
        Restart = "on-failure";
        RestartSec = 5;
        # 78 = EX_CONFIG: not paired yet; restarting cannot fix it.
        RestartPreventExitStatus = 78;
        TimeoutStopSec = 10;
        # Detached async jobs survive a restart.
        KillMode = "process";
        StateDirectory = "ctrl-exec-agent";
        StateDirectoryMode = "0750";
        StandardOutput = "journal";
        StandardError = "journal";

        NoNewPrivileges = true;
        ProtectSystem = "strict";
        ProtectHome = true;
        PrivateTmp = true;
        PrivateDevices = true;
        SystemCallFilter = [ "@system-service" "~@privileged @resources" ];
        CapabilityBoundingSet = "";
        AmbientCapabilities = "";
        RestrictAddressFamilies = "AF_UNIX AF_INET AF_INET6";
        RestrictNamespaces = true;
        LockPersonality = true;
        MemoryDenyWriteExecute = true;
        # '-': a missing directory is not an error (tmpfiles creates both).
        ReadOnlyPaths = [ "-${confDir}" "-${scriptsDir}" ];
      };
    };

    systemd.services.ctrl-exec-executor = lib.mkIf cfg.executor.enable {
      description = "ctrl-exec privileged executor (runs agent scripts under their profile)";
      documentation = [ "https://github.com/OpenDigitalCC/ctrl-exec" ];
      after = [ "network.target" ];
      wantedBy = [ "multi-user.target" ];
      restartTriggers = [ agentConf ];
      # Root by design and deliberately not sandboxed (CAP_SYS_ADMIN for the
      # mount namespace, setuid, full filesystem reach). It re-validates every
      # request against its own root-owned config.
      serviceConfig = {
        Type = "simple";
        ExecStart = "${cfg.package}/bin/ctrl-exec-executor serve ${execSock} ${confDir}/agent.conf ${confDir}/scripts.conf ctrl-exec-agent";
        Restart = "on-failure";
        RestartSec = 5;
        RuntimeDirectory = "ctrl-exec-agent";
        RuntimeDirectoryMode = "0755";
      };
    };

    # Adopt a renewed cert staged while the agent ran: restart only when one
    # is staged, so the ExecStartPre promote step installs it.
    systemd.services.ctrl-exec-agent-renew = {
      description = "ctrl-exec agent - restart to adopt a staged renewed certificate";
      documentation = [ "https://github.com/OpenDigitalCC/ctrl-exec" ];
      after = [ "ctrl-exec-agent.service" ];
      serviceConfig.Type = "oneshot";
      script = ''
        ${cfg.package}/bin/ctrl-exec-agent cert-staged \
          && ${config.systemd.package}/bin/systemctl try-restart ctrl-exec-agent.service \
          || true
      '';
    };
    systemd.timers.ctrl-exec-agent-renew = {
      description = "ctrl-exec agent - adopt a staged renewed certificate";
      wantedBy = [ "timers.target" ];
      timerConfig = {
        OnBootSec = "10min";
        OnUnitActiveSec = "1d";
        Persistent = true;
      };
    };
  };
}
