[Unit]
Description=ctrl-exec Agent - remote script execution service
Documentation=https://github.com/yourorg/ctrl-exec
After=network.target
Wants=network.target

[Service]
Type=simple
User=ctrl-exec-agent
Group=ctrl-exec-agent

# Promote a renewed cert staged (in the writable state dir) while the agent was
# running into the live cert path before the server starts. The '+' prefix runs
# this one step as root, outside the service sandbox, so it can write the
# root-owned /etc/ctrl-exec-agent that the main process is denied (ProtectSystem
# + ReadOnlyPaths below). It always succeeds: a missing or invalid staged cert
# leaves the existing cert in place and the agent starts normally.
ExecStartPre=+/usr/local/bin/ctrl-exec-agent promote-cert
ExecStart=/usr/local/bin/ctrl-exec-agent serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# 78 = EX_CONFIG, the exit code the serve pre-flight uses when the agent is not
# paired yet (no cert/key/CA). Restarting cannot fix that, so do not respawn on
# it: the unit fails once with the "not paired" message instead of looping.
RestartPreventExitStatus=78

# Give the process time to shut down cleanly
TimeoutStopSec=10

# Async (long-running) jobs run detached via setsid + double-fork. KillMode=process
# makes a stop/restart signal only the main process, leaving already-detached jobs
# to run to completion; the restarted agent serves their results from the store.
# The default control-group kill would otherwise terminate them on every restart.
KillMode=process

# Async result store: the agent writes /var/lib/ctrl-exec-agent/runs (and a
# .locks subdir). StateDirectory creates it owned by the service user and, under
# ProtectSystem=strict, makes it writable without a separate ReadWritePaths.
StateDirectory=ctrl-exec-agent
StateDirectoryMode=0750

# Operational logging goes via Sys::Syslog to journald.
# StandardError=journal captures Perl die/warn output that bypasses syslog.
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Allow reading config and certs
ReadOnlyPaths=/etc/ctrl-exec-agent

# Allow executing scripts in the managed scripts directory
ReadOnlyPaths=/opt/ctrl-exec-scripts

[Install]
WantedBy=multi-user.target
