[Unit]
Description=ctrl-exec dispatcher - certificate maintenance run
Documentation=https://github.com/OpenDigitalCC/ctrl-exec
After=network-online.target
Wants=network-online.target

# `maintain` runs every phase even if one fails, then exits 1 if any did, so a
# failed phase leaves this unit in the "failed" state (visible in `systemctl
# --failed` and to monitoring). Type=oneshot has no Restart=, so a failure is
# not retried in a loop: the next attempt is the timer's next interval.
[Service]
Type=oneshot
# Runs as root: signing a renewal needs the CA private key (/etc/ctrl-exec-dispatcher/ca.key,
# 0600 root) - the same privilege the manual `ced rotate-cert` / pairing-mode use.
# Pings every registered agent (triggering renewal when a cert is past half-life)
# and rotates/broadcasts the dispatcher's own cert when it nears expiry.
ExecStart=@BINDIR@/ctrl-exec-dispatcher maintain
