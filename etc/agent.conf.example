# ctrl-exec-agent configuration
# /etc/ctrl-exec-agent/agent.conf
#
# Comments must be on their own line (starting with '#'). An inline '# ...' after
# a value is NOT stripped - it becomes part of the value. So write a profile's
# caps as `caps = CAP_CHOWN, CAP_KILL`, with any note on a separate line above.

port = 7443
cert = /etc/ctrl-exec-agent/agent.crt
key  = /etc/ctrl-exec-agent/agent.key
ca   = /etc/ctrl-exec-agent/ca.crt

# Pairing port (default: 7444).
# Must match the --port value passed to ctrl-exec-agent request-pairing
# and the port used by ctrl-exec pairing-mode on the ctrl-exec host.
# pairing_port = 7444

# Trusted dispatchers (written automatically at pairing time).
# Path to the map of dispatcher cert serials this agent accepts, each with the
# dispatcher's stable identity. One entry per line: "<hex-serial> <id>".
# Every request (/run, /ping, /result, /capabilities) is rejected unless the
# peer's cert serial appears here; the matched identity is recorded for
# attribution and passed to the auth hook as ENVEXEC_DISPATCHER.
# Pairing appends to this map, so an agent can serve more than one dispatcher
# natively - re-pair with each. It lives in the agent-writable state directory
# (not the root-owned config dir) so cert rotation can update trusted serials in
# place, without re-pairing. Reloaded on SIGHUP alongside the allowlist and
# revocation list.
# trusted_dispatchers_path = /var/lib/ctrl-exec-agent/ctrl-exec-dispatchers

# Revoked certificate serials.
# Path to a file listing revoked TLS certificate serial numbers, one per line.
# Connections presenting a cert whose serial is in this list are rejected
# immediately after the mTLS handshake, before any request is processed.
# Format: lowercase hex serial as output by: openssl x509 -noout -serial -in cert.crt
# Lines beginning with # are treated as comments.
# The file is loaded at startup and reloaded on SIGHUP (systemctl reload ctrl-exec-agent).
# A missing or empty file means no certs are revoked - this is the normal state.
# revoked_serials = /etc/ctrl-exec-agent/revoked-serials

# Restrict scripts to approved directories (optional, recommended).
# Colon-separated list of absolute directory paths.
# If set, any script path in scripts.conf not under an approved directory
# is rejected at load time and re-validated at execution time.
#
# script_dirs = /opt/ctrl-exec-scripts:/usr/local/lib/ctrl-exec-scripts

# Privilege separation (optional, recommended).
# When set, the agent hands each synchronous run to the privileged executor
# (ctrl-exec-exec.service) over this unix socket; the executor re-derives the
# path and profile from its own root-owned config and applies the profile
# (run_as, capabilities, control/state dirs read-only) before exec.
#
# REQUIRED FOR PROFILES: per-script profiles (below) are enforced ONLY by the
# executor. With executor_socket unset, the agent runs scripts directly in its
# own process and the profile= in scripts.conf is ignored - see the profile
# section for exactly what scripts can do in that case.
#
# MUTUALLY EXCLUSIVE WITH ASYNC: while executor_socket is set, --async runs are
# refused (the executor does not yet handle detached jobs). Use synchronous runs
# with the executor, or leave executor_socket unset to use --async.
#
# Enabling this means: install and enable ctrl-exec-exec.service, then set the
# path below.
#
# executor_socket = /run/ctrl-exec-agent/exec.sock

# Async result store (optional).
# Directory where results of detached (--async) jobs are persisted, keyed by
# request id, until fetched or TTL-purged (24h). Defaults to the path below.
# The agent must be able to write it; the systemd unit's StateDirectory and the
# installer create it owned by the agent user (0750).
# Note: --async is unavailable while executor_socket is set (see above).
#
# async_runs_dir = /var/lib/ctrl-exec-agent/runs

# Agent-side auth hook (optional).
# Called before every run request, after allowlist validation.
# Receives full request context including username and token, enabling
# independent downstream token validation separate from the ctrl-exec's
# own auth hook.
# Hook must be executable. Exit 0 = authorised, 1/2/3 = denied.
# See REFERENCE.md for the hook interface and exit code semantics.
#
# auth_hook = /etc/ctrl-exec-agent/auth-hook

# Optional: restrict connections to known ctrl-exec IPs.
# Comma-separated list of IPs or CIDR prefixes (/8, /16, /24 only).
# If absent, all source IPs are accepted (mTLS still applies).
# Connections from unlisted IPs are closed before TLS handshake cost is paid.
# Reloaded on SIGHUP (systemctl reload ctrl-exec-agent).
#
# allowed_ips = 192.168.1.10, 10.0.0.0/8

# Connection rate limiting (optional).
# By default, rate limiting is active with the following thresholds:
#   Volume: 10 connections within 60s triggers a 5-minute block
#   Probe:  3 TLS handshake failures within 600s triggers a 1-hour block
#
# To disable rate limiting entirely (e.g. during testing):
# rate_limit_disable = 1
#
# To override thresholds, use limit/window/block format (all in seconds):
# rate_limit_volume = 10/60/300
# rate_limit_probe  = 3/600/3600

# Agent tags - reported in /capabilities response and ctrl-exec discovery.
# Use to group and filter agents by environment, role, location, etc.
#
# [tags]
# env  = prod
# role = db
# site = london

# Security profiles (optional).
# A profile is the security context a script runs under, applied by the agent's
# privileged executor before it execs the script: which user it runs as, which
# Linux capabilities it holds, and which paths it may write to. Scripts reference
# a profile by name in scripts.conf (profile=<name>); a script with no profile
# runs under the implicit, most-restrictive 'default' (unprivileged, no caps, no
# writable paths). The control/audit files are read-only to every profile,
# including root ones, so an action can never tamper with the agent's controls.
#
# PROFILES REQUIRE THE EXECUTOR. They are applied only when executor_socket is
# set (above) and ctrl-exec-exec.service is running. WITHOUT the executor the
# profile= in scripts.conf is parsed but NOT applied: every script instead runs
# directly in the agent process - as the unprivileged 'ctrl-exec-agent' user,
# with no added capabilities and the agent unit's filesystem sandbox (it can
# write only its own state directory). That is the only behaviour available
# without the executor, regardless of any profile= you set. To grant a script
# run_as/capabilities/writable paths, you MUST enable the executor.
#
# Fields per profile:
#   run_as            user (or uid) to drop to; omit to keep the agent's user
#   caps              comma/space-separated CAP_* to retain (e.g. CAP_CHOWN)
#   writable          colon-separated absolute dirs the script may write to
#   no_new_privileges yes (default) | no
#
# A script runs under exactly ONE profile - there is no stacking or inheritance.
# If a script needs more than one capability (e.g. deploy a cert AND restart a
# service), list them all in a single profile: caps = CAP_CHOWN, CAP_KILL.
# For the capability names and what each grants, see capabilities(7)
# (`man 7 capabilities`).
#
# run_as note: the script must be readable+executable by the run_as user - this
# is ordinary Unix exec permission. Scope a script to a service by its group:
# e.g. a script owned root:prosody mode 0750 works with run_as=prosody. A run_as
# user that cannot exec the script gets a clear error (not a silent failure).
#
# Define only the profiles you need; reference them from scripts.conf. Naming a
# profile in scripts.conf that is not defined here makes the agent refuse to
# serve (fail-closed).
#
# [profile read-only]
# # the default-equivalent: write nothing, no privilege
#
# [profile cert-deploy]
# run_as   = root
# caps     = CAP_CHOWN
# writable = /etc/nginx/ssl:/srv/certificates
#
# [profile svc-restart]
# run_as = root
# caps   = CAP_KILL
#
# [profile privileged]
# # full root, no FS restriction beyond the always-read-only control/audit
# # files. Use sparingly and pair the script with a strict argument schema.
# run_as = root
