# ctrl-exec.conf - ctrl-exec control host configuration

# mTLS certificate material (required)
cert = /etc/ctrl-exec-dispatcher/dispatcher.crt
key  = /etc/ctrl-exec-dispatcher/dispatcher.key
ca   = /etc/ctrl-exec-dispatcher/ca.crt

# Dispatcher identity.
# A stable label delivered to agents at pairing time and recorded by each agent
# as the owner of the jobs this dispatcher runs. Agents key per-dispatcher
# permission and attribution on it (it is exposed to agent auth hooks as
# ENVEXEC_DISPATCHER), and an agent that serves several dispatchers tells them
# apart by it. Defaults to this host's name; the installer may pre-set that.
# Use letters, digits, '.', '-', '_' (max 64). Changing it after agents have
# paired invalidates those pairings - the agents still hold the old identity, so
# re-pair them to adopt the new one.
# dispatcher_id = my-dispatcher

# Auth hook - called before every run and ping request, and for every API
# request. Not enabled by default: with no auth_hook, API requests are governed
# by api_auth_default (default: deny), so a fresh install refuses them until you
# decide. To enable one, write a hook (auth-hook.example, installed beside this
# file or under /usr/share/ctrl-exec/examples/, authorises EVERYTHING - copy it
# and add real rules), make it executable by the ctrl-exec user, then uncomment
# the line below and restart ctrl-exec-api. CLI use (ced) is gated by system
# permissions and does not need a hook.
# auth_hook = /etc/ctrl-exec-dispatcher/auth-hook

# What the API does when no auth_hook is set: deny (default) or allow. Ignored
# once a hook is configured. Set allow only on an isolated network.
# api_auth_default = deny

# Max seconds to wait for the auth hook to finish (default: 10). A hook that
# exceeds this is killed and the request is denied (fail closed), so a hook that
# blocks on an unreachable identity service cannot wedge the request.
# auth_hook_timeout = 10

# Read timeout in seconds: maximum time to wait for a script to complete (default: 60).
# Scripts that exceed this will be reported as a timeout failure.
# read_timeout = 60

# Max concurrent agent connections per fan-out operation (run/ping/discovery over
# a fleet) (default: 64). Bounds how many TLS clients are forked at once so a large
# fleet does not exhaust file descriptors; hosts beyond the cap queue.
# max_parallel = 64

# Largest total size in bytes of a run's confidential 'input' (the named string
# fields POST /run accepts for scripts that take secrets; default: 1048576). The
# API refuses a larger input with a 400, and its request body limit is 1 MiB
# plus this value. At most 32 fields. Set the agent's max_input_bytes alike.
# max_input_bytes = 1048576

# API listeners. The API can listen on a unix socket, on TCP, or on both at
# once (same requests, same auth hook). Confidential run input should only
# travel over the socket or TLS, never plain HTTP across a network.
#
# Unix socket for same-host callers (optional). Created mode 0660, so file
# permissions decide who may call: members of api_socket_group (default: the
# API's own group, ctrl-exec under the packaged service). The API's user must be
# a member of any group named here. /run/ctrl-exec-api is created by the
# packaged systemd unit. The auth hook still applies; it sees the caller as
# source_ip unix:<path> with the caller's uid in ENVEXEC_PEER_UID.
# api_socket = /run/ctrl-exec-api/api.sock
# api_socket_group = ctrl-exec

# API TCP port (default: 7445). Set api_port = off to listen on the socket only
# (api_socket must then be set). See api_bind below for the address.
# api_port = 7445

# TLS for the TCP listener (optional - plain HTTP if neither is set). Both must
# be set and readable by the API's user, or the API refuses to start. Clients
# verify the certificate (ctrl-exec-cli --ca FILE).
# api_cert = /etc/ctrl-exec-dispatcher/api.crt
# api_key  = /etc/ctrl-exec-dispatcher/api.key

# ctrl-exec certificate rotation
#
# cert_days: lifetime in days for new and renewed certs - both agent certs signed
#   at pairing/renewal and the ctrl-exec's own cert (default: 365).
# cert_renewal_days: begin renewal this many days before expiry (default: 90).
#   With cert_days = 365 and cert_renewal_days = 90, renewal begins at day 275.
# cert_overlap_days: how long to keep broadcasting after rotation before marking
#   unreachable agents as stale and requiring re-pair (default: 30).
# cert_check_interval: seconds between internal expiry checks (default: 14400 = 4h).
#   Reduce for testing. The check is lightweight - a cert read and date comparison.
#
# cert_days          = 365
# cert_renewal_days  = 90
# cert_overlap_days  = 30
# cert_check_interval = 14400

# API bind address (default: 127.0.0.1 - localhost only).
# Set to 0.0.0.0 to accept connections on all interfaces, or specify a
# particular interface address. Only change this if external clients need
# direct access; prefer a reverse proxy for internet-facing deployments.
# api_bind = 127.0.0.1

# Default auth behaviour when no auth_hook is configured.
# 'deny'  - all requests are rejected unless a hook is configured (default, recommended).
# 'allow' - all requests are authorised without a hook (suitable for isolated networks).
# When a hook is configured this setting has no effect.
api_auth_default = deny

# Max concurrent request handlers (default: 64). Connections beyond this are
# refused with 503 rather than forking another process, bounding a connection
# flood. Raise only if you genuinely sustain more than this many in-flight API
# requests.
# api_max_children = 64

# Generic auth denials (default off).
# When enabled, the API returns a generic 403 ("forbidden") for denied run,
# ping, and discovery requests, withholding the specific denial reason and
# code from the caller. This reduces information disclosure to unauthorised
# callers. The full reason is still logged server-side regardless. Off
# preserves the current behaviour of returning the detailed reason.
# auth_deny_generic = 0

# Pairing port (7444) rate limiting.
#
# Per-IP volume limiting on the pairing listener, mirroring the operational
# port. Limits how many pairing connections a single IP may open within a
# window before it is blocked, mitigating pairing-port abuse. Volume-only:
# the pairing port requires no client certificate, so there is no
# handshake-failure (probe) vector to track.
#
# pairing_rate_limit_volume = limit/window/block (seconds), default 10/60/300:
#   10 connections within 60s triggers a 300s (5 min) block for that IP.
# pairing_rate_limit_disable = 1  disables pairing-port rate limiting entirely.
#
# pairing_rate_limit_volume  = 10/60/300
# pairing_rate_limit_disable = 0

# Pairing-mode session timeout (seconds).
#
# 'pairing-mode' auto-stops after this many seconds so an unattended or
# backgrounded window cannot be left open indefinitely. The default is 600;
# the value may be shortened but not raised above 600. A --timeout flag on the
# command line overrides this for a single run. Applies to both the foreground
# session and 'pairing-mode start'.
#
# pairing_timeout = 600
