[Unit]
Description=ctrl-exec agent - restart to adopt a staged renewed certificate
Documentation=https://github.com/yourorg/ctrl-exec
After=ctrl-exec-agent.service

[Service]
Type=oneshot
# Restart the agent ONLY when a renewed cert has been staged (delivered while the
# agent was running). The restart triggers the unit's ExecStartPre promote step,
# which installs the staged cert; the server then comes up on it. No staged cert
# means no restart and no disruption. Runs as root (default) so try-restart works.
# `cert-staged` reads cert_staging_path from agent.conf, so an override is honoured
# without editing this unit.
ExecStart=/bin/sh -c 'ctrl-exec-agent cert-staged && systemctl try-restart ctrl-exec-agent.service || true'
