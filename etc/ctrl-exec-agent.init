#!/bin/sh /etc/rc.common
# ctrl-exec-agent - procd init script for OpenWrt
# Install to /etc/init.d/ctrl-exec-agent

USE_PROCD=1

# Start after network (80) and syslog (60); stop before network teardown
START=95
STOP=15

AGENT_BIN="/usr/local/bin/ctrl-exec-agent"
AGENT_USER="ctrl-exec-agent"
AGENT_CONF="/etc/ctrl-exec-agent/agent.conf"
AGENT_PIDFILE="/var/run/ctrl-exec-agent.pid"

start_service() {
    # Refuse to start if binary or config are absent
    [ -f "$AGENT_BIN" ]  || { logger -t ctrl-exec-agent "Binary not found: $AGENT_BIN"; return 1; }
    [ -f "$AGENT_CONF" ] || { logger -t ctrl-exec-agent "Config not found: $AGENT_CONF"; return 1; }

    # Gate startup on pairing state. procd has no RestartPreventExitStatus, so an
    # unpaired agent (serve exits 78, no cert) would respawn forever and spam the
    # log. If not paired, log once and do not open an instance; the operator runs
    # 'request-pairing' then '/etc/init.d/ctrl-exec-agent start'.
    if ! "$AGENT_BIN" paired 2>/dev/null; then
        logger -t ctrl-exec-agent "Not paired - not starting. Pair with: ctrl-exec-agent request-pairing --dispatcher <host>, then start again."
        return 1
    fi

    # Adopt a renewed cert staged while the agent was running. This runs as root
    # (start_service does, before procd drops the command to the agent user), so
    # it can promote the staged cert into the root-owned live path - the procd
    # equivalent of the systemd unit's ExecStartPre. A missing or invalid staged
    # cert is a harmless no-op; never block startup on it.
    "$AGENT_BIN" promote-cert 2>/dev/null || true

    procd_open_instance
    procd_set_param command "$AGENT_BIN" serve

    procd_set_param user "$AGENT_USER"

    procd_set_param pidfile "$AGENT_PIDFILE"

    # Restart on failure: check every 3600s, restart after 5s, no retry limit
    procd_set_param respawn 3600 5 0

    # Suppress stdout; stderr goes to logd -> syslog (matches systemd unit behaviour)
    procd_set_param stdout 0
    procd_set_param stderr 1

    procd_close_instance
}

stop_service() {
    # procd handles SIGTERM; this hook exists for any cleanup needed on stop
    return 0
}

reload_service() {
    # Send SIGHUP to trigger config reload (allowlist, auth hook, tags)
    local pid
    pid=$(cat "$AGENT_PIDFILE" 2>/dev/null) || return 0
    kill -HUP "$pid"
}
